{
  "manifest_version": 3,
  "name": "Instagram Growth Autopilot",
  "version": "0.2.0",
  "description": "Collects Instagram followers and runs a local follow and delayed-unfollow queue.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Instagram Growth Autopilot",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
